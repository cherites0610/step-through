---
// 圖：巢狀迴圈 for i = 1..n, for j = i..n 的執行次數＝三角形的格子數（n = 6）
const N = 6;
const CELL = 32;
const LEFT = 64;
const TOP = 36;
const W = LEFT + N * CELL + 150;
const H = TOP + N * CELL + 8;
const rows = Array.from({ length: N }, (_, r) => r + 1);
const total = (N * (N + 1)) / 2;
---

<svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`n = ${N} 時，第 i 列有 ${N}−i+1 個實心格，共 ${total} 個`}>
  <text class="mono" x={LEFT + (N * CELL) / 2} y="14" text-anchor="middle">j →</text>
  {rows.map((j) => <text class="mono" x={LEFT + (j - 1) * CELL + CELL / 2} y="30" text-anchor="middle">{j}</text>)}
  <text class="mono" x="10" y={TOP + (N * CELL) / 2} text-anchor="start">i ↓</text>
  {
    rows.map((i) => (
      <g>
        <text class="mono" x={LEFT - 12} y={TOP + (i - 1) * CELL + CELL / 2 + 4} text-anchor="end">{i}</text>
        {rows.map((j) =>
          j >= i ? (
            <rect x={LEFT + (j - 1) * CELL + 11} y={TOP + (i - 1) * CELL + 11} width="10" height="10" fill="var(--color-ink)" />
          ) : (
            <rect x={LEFT + (j - 1) * CELL + 11.5} y={TOP + (i - 1) * CELL + 11.5} width="9" height="9" class="axis" />
          ),
        )}
        <text class="mono" x={LEFT + N * CELL + 16} y={TOP + (i - 1) * CELL + CELL / 2 + 4}>{N - i + 1} 次</text>
      </g>
    ))
  }
  <path d={`M${LEFT - 4} ${TOP} L${LEFT - 4} ${TOP + N * CELL}`} class="axis" />
  <path d={`M${LEFT} ${TOP - 2} L${LEFT + N * CELL} ${TOP - 2}`} class="axis" />
</svg>
