---
// 圖中的小表格：表頭用墨線、內容用髮絲線。strike＝被刪除的列（畫刪除線），mark＝要強調的格子（黑底），box／boxCol＝加粗框的列／欄。
interface Props {
  x: number;
  y: number;
  name?: string;
  cols: string[];
  rows: (string | null)[][];
  colW: number[];
  cellH?: number;
  strike?: number[];
  mark?: [number, number][];
  /** 加粗框的列（資料列的索引） */
  box?: number[];
  /** 加粗框的欄（含表頭） */
  boxCol?: number;
  /** false＝不畫表頭（接在另一個表格下方） */
  header?: boolean;
}
const { x, y, name, cols, rows, colW, cellH = 20, strike = [], mark = [], box = [], boxCol, header = true } = Astro.props;
const lead = header ? 1 : 0;
const top = name ? y + 16 : y;
const colX = colW.map((_, i) => x + colW.slice(0, i).reduce((a, b) => a + b, 0));
const width = colW.reduce((a, b) => a + b, 0);
const isMarked = (r: number, c: number) => mark.some(([mr, mc]) => mr === r && mc === c);
---

{name && <text class="mono" x={x} y={y + 10}>{name}</text>}
{
  (header ? [cols, ...rows] : rows).map((r, ri) => {
    const ry = top + ri * cellH;
    const dataRow = ri - lead;
    const isHead = header && ri === 0;
    return (
      <>
        {r.map((v, ci) => {
          const marked = !isHead && isMarked(dataRow, ci);
          return (
            <>
              <rect
                class={isHead || marked ? 'ink' : 'axis'}
                x={colX[ci] + 0.5}
                y={ry + 0.5}
                width={colW[ci] - 1}
                height={cellH - 1}
                style={marked ? 'fill: var(--color-ink)' : undefined}
              />
              <text class="mono" x={colX[ci] + 6} y={ry + 14} style={marked ? 'fill: var(--color-paper)' : undefined}>
                {v ?? 'NULL'}
              </text>
            </>
          );
        })}
        {!isHead && strike.includes(dataRow) && <path class="ink" d={`M${x} ${ry + cellH / 2} L${x + width} ${ry + cellH / 2}`} />}
      </>
    );
  })
}
{box.map((r) => <rect class="ink" x={x - 1} y={top + (r + lead) * cellH - 1} width={width + 2} height={cellH + 2} stroke-width="2" />)}
{boxCol !== undefined && <rect class="ink" x={colX[boxCol] - 1} y={top - 1} width={colW[boxCol] + 2} height={(rows.length + lead) * cellH + 2} stroke-width="2" />}
