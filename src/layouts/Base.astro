---
import '../styles/global.css';
import { t, type Locale } from '../i18n';
import Analytics from '../components/Analytics.astro';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  path?: string;
  jsonLd?: object[];
  /** Open Graph 圖的路徑（站內，例如 /og/zh-TW/quick-sort.png）；預設用該語系的首頁圖 */
  image?: string;
  /** og:type：首頁 website，主題頁 article */
  type?: 'website' | 'article';
  /** 不要被索引的頁面（404）：不輸出 canonical、og:url */
  noindex?: boolean;
}
const {
  lang,
  title,
  description,
  path = '',
  jsonLd = [],
  image,
  type = 'website',
  noindex = false,
} = Astro.props;
const desc = description ?? t(lang).description;
const canonical = new URL(`/${lang}/${path}`, Astro.site);
const ogImage = new URL(image ?? `/og/${lang}/home.png`, Astro.site);
// og:locale 的格式是 zh_TW（底線），和 lang 的連字號不同
const ogLocale: Record<Locale, string> = { 'zh-TW': 'zh_TW' };
const siteName = t(lang).siteName;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F5F4F6" />
    <!--
      點連結進入的新頁面一律從最上方開始。iPhone Safari 會把新頁面停在上一頁的捲動高度
      （在章節頁底部點「接著可以讀」時遇到），而且是在載入之後才捲過去，所以：
      1. 在首次繪製前就先關掉這一頁的捲動還原並回到頂端；
      2. 載入期間只要被捲離頂端就拉回來，直到 load 之後 400ms 內都沒有再被捲動（最多 1.5 秒）；
         使用者一碰觸、捲動或按鍵就立刻停止；
      3. 結束後恢復 auto，讓之後按「上一頁」回到這一頁時仍保留閱讀位置。
      只處理一般的連結導覽（不含上一頁／下一頁、重新整理），網址有 #錨點 時交給錨點。
      網址加上 ?debug=scroll 會在右下角列出捲動紀錄（暫時的診斷工具）。
    -->
    <script is:inline>
      (function () {
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        var debug = /[?&]debug=scroll\b/.test(location.search);
        var log = [];
        var t0 = performance.now();
        var note = function (what) {
          if (!debug) return;
          log.push(Math.round(performance.now() - t0) + 'ms ' + what + ' y=' + Math.round(window.scrollY));
          var box = document.getElementById('scroll-debug');
          if (box) box.textContent = log.join('\n');
        };
        if (debug) {
          document.addEventListener('DOMContentLoaded', function () {
            var box = document.createElement('pre');
            box.id = 'scroll-debug';
            box.style.cssText = 'position:fixed;left:4px;top:60px;z-index:99;max-height:40vh;overflow:hidden;margin:0;padding:6px;background:#16181a;color:#f5f4f6;font:11px/1.4 monospace;white-space:pre;opacity:.9;pointer-events:none';
            document.body.appendChild(box);
            note('dom');
          });
          note('start type=' + (nav ? nav.type : '?') + ' hash=' + (location.hash || '-'));
        }
        if (!nav || nav.type !== 'navigate' || location.hash) return;
        var root = document.documentElement;
        root.dataset.scrollGuard = 'on';
        var hist = window.history;
        if ('scrollRestoration' in hist) hist.scrollRestoration = 'manual';
        var stopped = false;
        var finish = function () {
          if (root.dataset.scrollGuard === 'done') return;
          stopped = true;
          if ('scrollRestoration' in hist) hist.scrollRestoration = 'auto';
          root.dataset.scrollGuard = 'done';
          note('done');
        };
        var stop = finish;
        var lastPull = performance.now();
        ['touchstart', 'wheel', 'keydown', 'mousedown'].forEach(function (ev) {
          window.addEventListener(ev, stop, { once: true, passive: true, capture: true });
        });
        var toTop = function (why) {
          if (!stopped && window.scrollY !== 0) {
            note('pull (' + why + ')');
            lastPull = performance.now();
            window.scrollTo(0, 0);
          }
        };
        toTop('head');
        window.addEventListener('scroll', function () {
          if (!stopped) toTop('scroll');
        }, { passive: true });
        document.addEventListener('DOMContentLoaded', function () {
          toTop('dom');
        });
        window.addEventListener('pageshow', function () {
          toTop('pageshow');
        });
        window.addEventListener('load', function () {
          toTop('load');
          var start = performance.now();
          lastPull = start;
          (function tick() {
            if (stopped) return;
            toTop('frame');
            var now = performance.now();
            if (now - lastPull > 400 || now - start > 1500) finish();
            else requestAnimationFrame(tick);
          })();
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Analytics />
    {
      jsonLd.map((d) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(d)} />
      ))
    }
  </head>
  <body>
    <slot />
    <script>
      import '../lib/progress-dom';
    </script>
    <script>
      // 同一頁內的錨點連結（地圖節點、建議先讀、瀏覽科目）不新增瀏覽紀錄：
      // 否則手機的「上一頁」會先在頁內的錨點之間來回，回不到上一頁。
      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = (e.target as Element | null)?.closest('a');
        const href = a?.getAttribute('href') ?? '';
        if (href.length < 2 || !href.startsWith('#')) return;
        const target = document.getElementById(decodeURIComponent(href.slice(1)));
        if (!target) return;
        e.preventDefault();
        history.replaceState(history.state, '', href);
        target.scrollIntoView();
        // 讓鍵盤與螢幕閱讀器的位置也跟著移過去
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
