---
import '../styles/global.css';
import { locales, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  path?: string;
  /** 此頁實際存在的語系（hreflang 只列出這些） */
  alternates?: readonly Locale[];
  jsonLd?: object[];
}
const { lang, title, description, path = '', alternates = locales, jsonLd = [] } = Astro.props;
const desc = description ?? t(lang).description;
const canonical = new URL(`/${lang}/${path}`, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(`/${l}/${path}`, Astro.site)} />
      ))
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      jsonLd.map((d) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(d)} />
      ))
    }
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
