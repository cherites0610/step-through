---
import '../styles/global.css';
import { t, type Locale } from '../i18n';
import Analytics from '../components/Analytics.astro';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  path?: string;
  jsonLd?: object[];
  /** Open Graph 圖的路徑（站內，例如 /og/zh-TW/quick-sort.png）；預設用該語系的首頁圖 */
  image?: string;
  /** og:type：首頁 website，主題頁 article */
  type?: 'website' | 'article';
  /** 不要被索引的頁面（404）：不輸出 canonical、og:url */
  noindex?: boolean;
}
const {
  lang,
  title,
  description,
  path = '',
  jsonLd = [],
  image,
  type = 'website',
  noindex = false,
} = Astro.props;
const desc = description ?? t(lang).description;
const canonical = new URL(`/${lang}/${path}`, Astro.site);
const ogImage = new URL(image ?? `/og/${lang}/home.png`, Astro.site);
// og:locale 的格式是 zh_TW（底線），和 lang 的連字號不同
const ogLocale: Record<Locale, string> = { 'zh-TW': 'zh_TW' };
const siteName = t(lang).siteName;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F5F4F6" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Analytics />
    {
      jsonLd.map((d) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(d)} />
      ))
    }
  </head>
  <body>
    <slot />
    <script>
      // 同一頁內的錨點連結（地圖節點、建議先讀、瀏覽科目）不新增瀏覽紀錄：
      // 否則手機的「上一頁」會先在頁內的錨點之間來回，回不到上一頁。
      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = (e.target as Element | null)?.closest('a');
        const href = a?.getAttribute('href') ?? '';
        if (href.length < 2 || !href.startsWith('#')) return;
        const target = document.getElementById(decodeURIComponent(href.slice(1)));
        if (!target) return;
        e.preventDefault();
        history.replaceState(history.state, '', href);
        target.scrollIntoView();
        // 讓鍵盤與螢幕閱讀器的位置也跟著移過去
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
