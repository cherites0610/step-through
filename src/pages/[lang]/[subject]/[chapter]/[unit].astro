---
import { getCollection, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import SortViz from '../../../../components/viz/sorting/SortViz.svelte';
import AvlViz from '../../../../components/viz/avl/AvlViz.svelte';
import { t, type Locale } from '../../../../i18n';
import { chapterPath, locateTopic, pad2, subjectPath, topicOrder, topicPath } from '../../../../data/subjects';

export async function getStaticPaths() {
  const all = await getCollection('topics');
  return all.map((entry) => {
    // 科目、章節都以 src/data/subjects.ts 為唯一來源；主題沒登記時在建置階段就報錯
    const loc = locateTopic(entry.data.topic);
    if (!loc) throw new Error(`主題 "${entry.data.topic}" 沒有登記在 src/data/subjects.ts`);
    return {
      params: { lang: entry.data.lang, subject: loc.subject.id, chapter: loc.chapter.id, unit: entry.data.topic },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Locale;
const text = t(lang);
const d = entry.data;
const { Content } = await render(entry);

const { subject, chapter, index } = locateTopic(d.topic)!;
const plateLabel = `${pad2(chapter.no)} ${chapter.title} · ${pad2(index)}`;
const subjectHref = subjectPath(lang, subject);
const chapterHref = chapterPath(lang, subject, chapter);
const chapterName = `${pad2(chapter.no)} ${chapter.title}`;

const siblings = (await getCollection('topics'))
  .filter((e) => e.data.lang === lang && locateTopic(e.data.topic)?.chapter.id === chapter.id)
  .sort((a, b) => topicOrder.indexOf(a.data.topic) - topicOrder.indexOf(b.data.topic));

const displayName = `${d.title}（${d.titleEn}）`;
const path = topicPath(lang, d.topic);
const url = new URL(path, Astro.site).href;
const ogImagePath = `/og/${lang}/${d.topic}.png`;
const ogImageUrl = new URL(ogImagePath, Astro.site).href;

// 上一個／下一個主題：依路線圖順序，只含這個語系已上線的
const ordered = (await getCollection('topics'))
  .filter((e) => e.data.lang === lang)
  .sort((a, b) => topicOrder.indexOf(a.data.topic) - topicOrder.indexOf(b.data.topic));
const at = ordered.findIndex((e) => e.data.topic === d.topic);
const prev = at > 0 ? ordered[at - 1] : undefined;
const next = at < ordered.length - 1 ? ordered[at + 1] : undefined;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: displayName,
    description: d.description,
    inLanguage: lang,
    url,
    learningResourceType: 'Interactive visualization',
    interactivityType: 'active',
    teaches: d.titleEn,
    image: ogImageUrl,
    isAccessibleForFree: true,
    audience: { '@type': 'EducationalAudience', educationalRole: 'student' },
    isPartOf: { '@type': 'WebSite', name: text.siteName, url: new URL(`/${lang}/`, Astro.site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: text.siteName, item: new URL(`/${lang}/`, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: subject.title, item: new URL(subjectHref, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: chapterName, item: new URL(chapterHref, Astro.site).href },
      { '@type': 'ListItem', position: 4, name: d.title, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
const cr = text.complexityRows;
const rows: [string, string][] = [
  [cr.best, d.complexity.best],
  [cr.average, d.complexity.average],
  [cr.worst, d.complexity.worst],
  [cr.space, d.complexity.space],
  ...(d.complexity.stable === undefined
    ? []
    : [[cr.stable, d.complexity.stable ? cr.yes : cr.no] as [string, string]]),
];
---

<Base
  lang={lang}
  title={`${displayName} ${text.interactive}｜${text.siteName}`}
  description={d.description}
  path={path.replace(`/${lang}/`, '')}
  jsonLd={jsonLd}
  image={ogImagePath}
  type="article"
>
  <header class="sticky top-0 z-20 bg-paper flex h-14 items-center gap-3 whitespace-nowrap border-b border-hairline px-4 md:gap-6">
    <a href={`/${lang}/`} class="shrink-0 font-medium max-md:hidden">{text.siteName}</a>
    <a href={subjectHref} class="shrink-0 text-[15px] underline-offset-4 hover:underline max-md:hidden">{subject.title}</a>
    <!-- 手機：回到這一章，是唯一的返回連結，所以加箭頭與底線 -->
    <a href={chapterHref} class="min-w-0 truncate text-[15px] underline underline-offset-4 md:hidden">← {chapter.title}</a>
    <a
      href={chapterHref}
      class="hidden font-mono text-[11px] uppercase tracking-[0.14em] underline-offset-4 hover:underline md:inline"
      >{plateLabel}</a
    >
    <span class="hidden text-[15px] md:inline">{d.title}</span>
    <a href={`/${lang}/`} class="ml-auto shrink-0 font-medium md:hidden">{text.siteName}</a>
  </header>

  <div class="md:grid md:grid-cols-[220px_1fr]">
    <nav
      class="border-b border-hairline px-4 py-4 md:border-b-0 md:border-r"
      aria-label={text.topics}
    >
      <a
        href={chapterHref}
        class="mb-3 inline-block whitespace-nowrap text-[13px] underline underline-offset-4 max-md:hidden"
      >
        ← {chapterName}
      </a>
      <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.14em] md:hidden">{chapterName}</p>
      <ul class="flex gap-4 overflow-x-auto md:flex-col md:gap-0">
        {
          siblings.map((s) => (
            <li>
              <a
                href={topicPath(lang, s.data.topic)}
                aria-current={s.data.topic === d.topic ? 'page' : undefined}
                class:list={[
                  'block whitespace-nowrap px-2 py-1.5 text-[15px]',
                  s.data.topic === d.topic && 'bg-stamp outline outline-1 outline-ink',
                ]}
              >
                {s.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <main class="min-w-0" data-visit={`${subject.id}/${chapter.id}`}>
      <div class="px-4 pt-8 lg:px-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em]">{d.titleEn}</p>
        <h1 class="text-[44px] leading-[1.1] tracking-[-0.02em] max-md:text-[32px]">{d.title}</h1>
        <p class="mt-3 max-w-[65ch] text-[15px]">{d.description}</p>
      </div>

      {
        d.kind === 'tree' ? (
          <AvlViz client:load lang={lang} initial={d.example} />
        ) : (
          <SortViz
            client:load
            lang={lang}
            algo={d.algo as 'insertion' | 'bubble' | 'selection' | 'merge' | 'quick'}
            initial={d.example}
          />
        )
      }

      <article class="border-t border-hairline px-4 py-10 lg:px-8">
        <div class="prose-plate max-w-[65ch]">
          <Content />
        </div>

        <h2 class="mt-12 text-[22px]">{text.toc.complexity}</h2>
        <table class="mt-3 w-full max-w-md border-y border-hairline font-mono text-[15px]">
          <tbody>
            {
              rows.map(([k, v]) => (
                <tr class="border-b border-hairline last:border-b-0">
                  <th scope="row" class="py-2 pr-4 text-left font-sans font-normal">{k}</th>
                  <td class="py-2">{v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <h2 class="mt-12 text-[22px]">{text.toc.faq}</h2>
        <dl class="mt-3 max-w-[65ch]">
          {
            d.faq.map((f) => (
              <>
                <dt class="mt-5 font-medium">{f.q}</dt>
                <dd class="mt-1">{f.a}</dd>
              </>
            ))
          }
        </dl>

        <!-- 上一個／下一個主題：內部連結，也讓讀者可以直接往下學 -->
        <nav class="mt-14 grid max-w-[65ch] border-t border-ink sm:grid-cols-2" aria-label={text.topicNav.label}>
          <div class="border-b border-hairline py-4 sm:border-b-0 sm:border-r sm:pr-4">
            {
              prev && (
                <a href={topicPath(lang, prev.data.topic)} class="block hover:bg-stamp hover:outline hover:outline-1 hover:outline-ink">
                  <span class="block font-mono text-[11px] uppercase tracking-[0.14em]">← {text.topicNav.prev}</span>
                  <span class="mt-1 block text-[17px]">{prev.data.title}</span>
                </a>
              )
            }
          </div>
          <div class="py-4 sm:pl-4 sm:text-right">
            {
              next && (
                <a href={topicPath(lang, next.data.topic)} class="block hover:bg-stamp hover:outline hover:outline-1 hover:outline-ink">
                  <span class="block font-mono text-[11px] uppercase tracking-[0.14em]">{text.topicNav.next} →</span>
                  <span class="mt-1 block text-[17px]">{next.data.title}</span>
                </a>
              )
            }
          </div>
        </nav>
      </article>
    </main>
  </div>
</Base>
