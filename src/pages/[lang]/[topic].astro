---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import ProjectionToggle from '../../components/ProjectionToggle.astro';
import SortViz from '../../components/viz/sorting/SortViz.svelte';
import { t, type Locale } from '../../i18n';

export async function getStaticPaths() {
  const all = await getCollection('topics');
  return all.map((entry) => ({
    params: { lang: entry.data.lang, topic: entry.data.topic },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Locale;
const text = t(lang);
const d = entry.data;
const { Content } = await render(entry);

const siblings = (await getCollection('topics'))
  .filter((e) => e.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
const alternates = (await getCollection('topics'))
  .filter((e) => e.data.topic === d.topic)
  .map((e) => e.data.lang);

const displayName = lang === 'en' ? d.title : `${d.title}（${d.titleEn}）`;
const url = new URL(`/${lang}/${d.topic}/`, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: displayName,
    description: d.description,
    inLanguage: lang,
    url,
    learningResourceType: 'Interactive visualization',
    interactivityType: 'active',
    teaches: d.titleEn,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
const cr = text.complexityRows;
const rows: [string, string][] = [
  [cr.best, d.complexity.best],
  [cr.average, d.complexity.average],
  [cr.worst, d.complexity.worst],
  [cr.space, d.complexity.space],
  [cr.stable, d.complexity.stable ? cr.yes : cr.no],
];
---

<Base
  lang={lang}
  title={`${displayName} ${text.interactive}｜${text.siteName}`}
  description={d.description}
  path={`${d.topic}/`}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <header class="flex h-14 items-center gap-3 whitespace-nowrap border-b border-hairline px-4 md:gap-6">
    <a href={`/${lang}/`} class="shrink-0 font-medium">{text.siteName}</a>
    <span class="hidden font-mono text-[11px] uppercase tracking-[0.14em] md:inline"
      >Plate {String(d.order).padStart(2, '0')}</span
    >
    <span class="hidden text-[15px] md:inline">{d.title}</span>
    <div class="ml-auto flex shrink-0 items-center gap-2 md:gap-4">
      <ProjectionToggle lang={lang} />
      <LangSwitch lang={lang} path={`${d.topic}/`} available={alternates} />
    </div>
  </header>

  <div class="topic-shell md:grid md:grid-cols-[220px_1fr]">
    <nav
      class="chapter-rail border-b border-hairline px-4 py-4 md:border-b-0 md:border-r"
      aria-label={text.topics}
    >
      <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.14em]">{text.sorting}</p>
      <ul class="flex gap-4 overflow-x-auto md:flex-col md:gap-0">
        {
          siblings.map((s) => (
            <li>
              <a
                href={`/${lang}/${s.data.topic}/`}
                aria-current={s.data.topic === d.topic ? 'page' : undefined}
                class:list={[
                  'block whitespace-nowrap px-2 py-1.5 text-[15px]',
                  s.data.topic === d.topic && 'bg-stamp outline outline-1 outline-ink',
                ]}
              >
                {s.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <main class="min-w-0">
      <div class="px-4 pt-8 lg:px-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em]">{d.titleEn}</p>
        <h1 class="text-[44px] leading-[1.1] tracking-[-0.02em] max-md:text-[32px]">{d.title}</h1>
        <p class="mt-3 max-w-[65ch] text-[15px]">{d.description}</p>
      </div>

      <SortViz client:load lang={lang} algo={d.algo} initial={d.example} />

      <article class="border-t border-hairline px-4 py-10 lg:px-8">
        <div class="prose-plate max-w-[65ch]">
          <Content />
        </div>

        <h2 class="mt-12 text-[22px]">{text.toc.complexity}</h2>
        <table class="mt-3 w-full max-w-md border-y border-hairline font-mono text-[15px]">
          <tbody>
            {
              rows.map(([k, v]) => (
                <tr class="border-b border-hairline last:border-b-0">
                  <th scope="row" class="py-2 pr-4 text-left font-sans font-normal">{k}</th>
                  <td class="py-2">{v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <h2 class="mt-12 text-[22px]">{text.toc.faq}</h2>
        <dl class="mt-3 max-w-[65ch]">
          {
            d.faq.map((f) => (
              <>
                <dt class="mt-5 font-medium">{f.q}</dt>
                <dd class="mt-1">{f.a}</dd>
              </>
            ))
          }
        </dl>
      </article>
    </main>
  </div>
</Base>
