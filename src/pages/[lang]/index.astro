---
import Base from '../../layouts/Base.astro';
import Player from '../../components/player/Player.svelte';
import { locales, t, type Locale } from '../../i18n';
import type { Trace } from '../../core/trace';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const text = t(lang);

// M0 示範用軌跡：倒數。之後由各主題的 trace 函式取代。
const demo: Trace<number> = [3, 2, 1, 0].map((n) => ({
  state: n,
  highlight: [],
  line: 0,
  explain: { key: 'demo.countdown', params: { n } },
}));
---

<Base lang={lang} title={`${text.siteName}｜${text.tagline}`}>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <p class="font-mono text-[11px] uppercase tracking-[0.14em]">Plate 00</p>
    <h1 class="text-[44px] leading-[1.1] tracking-[-0.02em]">{text.siteName}</h1>
    <p class="mt-4 max-w-[65ch]">{text.description}</p>
    <Player client:load steps={demo} labels={text} />
  </main>
</Base>
