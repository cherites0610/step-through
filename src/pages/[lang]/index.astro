---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { locales, t, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const text = t(lang);
const topics = (await getCollection('topics'))
  .filter((e) => e.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base lang={lang} title={`${text.siteName}｜${text.tagline}`}>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <p class="font-mono text-[11px] uppercase tracking-[0.14em]">Plate 00</p>
    <h1 class="text-[44px] leading-[1.1] tracking-[-0.02em]">{text.siteName}</h1>
    <p class="mt-4 max-w-[65ch]">{text.description}</p>

    <h2 class="mt-12 font-mono text-[11px] uppercase tracking-[0.14em]">
      {text.home.topicsHeading}
    </h2>
    {
      topics.length === 0 ? (
        <p class="mt-3">{text.home.empty}</p>
      ) : (
        <ul class="mt-3 border-t border-hairline">
          {topics.map((s) => (
            <li class="border-b border-hairline">
              <a href={`/${lang}/${s.data.topic}/`} class="flex items-baseline gap-4 py-3 hover:bg-stamp">
                <span class="font-mono text-[11px] uppercase tracking-[0.14em]">
                  Plate {String(s.data.order).padStart(2, '0')}
                </span>
                <span class="text-[17px]">{s.data.title}</span>
                <span class="font-mono text-[13px]">{s.data.titleEn}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Base>
