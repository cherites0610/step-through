---
// 根路徑只負責把人送到 /zh-TW/：不顯示任何文字，腳本在 <head> 內同步執行，
// 瀏覽器還沒繪製第一個畫面就已經跳轉。沒有 JS 時退回 meta refresh 與一個連結。
// 正式環境由 public/_redirects 直接 301，這一頁只在本機預覽與備援時用到。
const zh = new URL('/zh-TW/', Astro.site!).href;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>步步看懂 Step Through</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={zh} />
    <style is:inline>
      html {
        background: #f5f4f6;
      }
    </style>
    <script is:inline>
      location.replace('/zh-TW/' + location.search + location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content="0;url=/zh-TW/" /></noscript>
  </head>
  <body>
    <noscript>
      <p><a href="/zh-TW/">步步看懂</a></p>
    </noscript>
  </body>
</html>
